{
  "name": "algeriom",
  "version": "1.0.0",
  "description": "Algeriom — a browser for Algeria",
  "main": "main.js",
  "author": "Algeriom",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.algeriom.browser",
    "productName": "Algeriom",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage", "category": "Network" }
  }
}
